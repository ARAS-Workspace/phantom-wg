# ──────────────────────────────────────────────────────────────────
# phantom-daemon  ·  Environment Variables
# ──────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────
PYTHONUNBUFFERED=1

# Daemon log level: critical | error | warning | info | debug
# Also drives uvicorn's level. Unknown values fall back to 'info'.
PHANTOM_LOG_LEVEL=info

# ── Daemon Storage ───────────────────────────────────────────────
PHANTOM_DB_DIR=/var/lib/phantom/db
PHANTOM_STATE_DIR=/var/lib/phantom/state/db

# ── WireGuard ────────────────────────────────────────────────────
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_MTU=1420
WIREGUARD_KEEPALIVE=25
WIREGUARD_ENDPOINT_V4=
WIREGUARD_ENDPOINT_V6=