# ──────────────────────────────────────────────────────────────────
# phantom-nginx  ·  Cloudflare mode
# ──────────────────────────────────────────────────────────────────
# ./tools/prod.sh cloudflare on copies this file to .env.cf. The copy
# belongs to this machine: git does not track it, the tool holds it at 600.
#   on    takes an Origin CA certificate for CF_HOSTNAMES and serves the
#         stack through Cloudflare
#   off   revokes that certificate and takes the mode back
# Before on, in the Cloudflare dashboard of the zone: SSL/TLS mode
# Full (strict), Authenticated Origin Pulls on.

# ── API token ─────────────────────────────────────────────────────
# A token of this zone only, with these permissions:
#   Zone - Zone - Read
#   Zone - Zone Settings - Read
#   Zone - SSL and Certificates - Edit
CF_API_TOKEN=

# ── Zone ──────────────────────────────────────────────────────────
CF_ZONE=

# Hostnames of the Origin CA certificate, comma separated.
# Empty: the zone and *.<zone>.
CF_HOSTNAMES=
