# ──────────────────────────────────────────────────────────────────
# phantom-wg  ·  Environment Variables
# ──────────────────────────────────────────────────────────────────
# Read by compose and passed to auth-service.

# ── Images ────────────────────────────────────────────────────────
# registry pulls the release images; build builds them here from the
# same Dockerfiles. Switch with: ./tools/prod.sh images use <source>
PHANTOM_IMAGE_SOURCE=registry

# ── Network ───────────────────────────────────────────────────────
PHANTOM_SUBNET_V4=172.28.0.0/24
PHANTOM_SUBNET_V6=fd00:d0ce::/64
